rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /players/{id} { allow read: if request.auth != null; allow write: if false; }
    match /config/{id}  { allow read: if request.auth != null; allow write: if false; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['displayName', 'avatarId', 'settings', 'lastLoginAt']);

      match /wallet/{doc}       { allow read: if isOwner(uid); allow write: if false; }
      match /debts/{doc}        { allow read: if isOwner(uid); allow write: if false; }
      match /ledger/{doc}       { allow read: if isOwner(uid); allow write: if false; }
      match /ownedPlayers/{doc} { allow read: if isOwner(uid); allow write: if false; }
      match /squads/{doc}       { allow read, write: if isOwner(uid); }
    }

    match /clubs/{uid} { allow read: if request.auth != null; allow write: if false; }
    match /leaderboards/{s}/entries/{uid} { allow read: if request.auth != null; allow write: if false; }
  }
}
